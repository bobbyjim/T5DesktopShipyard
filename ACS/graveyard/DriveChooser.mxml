			private function setFuelThingy( category:String, 
											label:String, 
											tl:int, 
											count:int, 
											tonsPerHour:int=0, // per ton
											mcrPerUnit:Number=1,
											tonsPerUnit:int=1, 
											notes:String='' ):void
			{
				shipGrid.remove( category );
				
				if ( count == 0 ) return;
				
				var tons:int   = count * tonsPerUnit;
				var mcr:Number = count * mcrPerUnit;
				
				if ( notes == '' && tonsPerHour > 0 )
				{
					notes = tonsPerHour * tons + 't/hr';
				}
				
				shipGrid.addComponent(
					{
						type: 'Drives',
						category: category,
						label: label,
						tl: tl,
						tons: tons,
						count: count,
						mcr: mcr,
						CP: 1,
						notes: notes
					}
				);
			}
			
