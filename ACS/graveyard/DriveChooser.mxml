			private function getEP( value:int ):int
			{
				var tons:int = Cfg.getHdr().tons;
				var EP:int = Math.ceil( value * tons / 200 ) * 100;
				if ( EP > 2400 )
					EP = Math.ceil( EP/200 ) * 200;
				
				return EP;
			}
			
			private function getDriveMult( EP:int ):int
			{
				return 1+int( (EP-1) / 2400 );				
			}
			
			private function getDriveLetter( EP:int ):String
			{
				var mult:int = getDriveMult( EP );
				var eachEP:int = Math.ceil( EP/mult );
				var index:int  = Math.ceil( eachEP/100 )-1;
				var letter:String = letters[ Math.ceil(index) ];

				if ( mult > 1 )
					return letter + mult;
				else
					return letter; // single drive
			}
			
			private function getDriveTons( tonsPerEP:String, EP:int, minTons:int ):Number
			{
				var equation:Array = tonsPerEP.split( '+' );
				var sPercent:String = equation[0].toString().replace( '%', '' );
				var percent:Number  = parseFloat(sPercent) / 100;
				var constant:Number = parseFloat(equation[1]);
				
				//var mult:int = getDriveMult( EP );
				var tons:Number = (constant + EP * percent); // * mult;
				tons = Math.max( tons, minTons );
				
				return tons;
			}
			
			private function getDriveNote( rating:int, prefix:String, suffix:String ):String
			{
				var note:String = prefix;
				
				if ( note == null ) 
					note = '' + rating;
				else
					note += ' ' + rating;
				
				if ( suffix != null )
					note += ' ' + suffix;
				
				return note;
			}
			
			private function findBaseTL( base:int, dat:Array, r:int ):int
			{
				for( var i:int=0; i<dat.length; i++ )
				{
					if ( dat[i] < r ) 
						base++;
				}
				
				return base;
			}
			
			private function setDrive( code:String, event:Event=null ):Object
			{
				var coreData:Object = drives.drives.codes[ code ];
				var category:String = coreData.label;
				var old:Object = shipGrid.find( category );

				var value:Number = 0;
				
				//
				// A null event means we're forcing a recalculation.
				// So, try to use the current rating of the drive we just removed.
				//
				if ( event != null )    value = event.target.value; // 0 - 9
				else if ( old != null )	value = old.rating;

				if ( value == 0 ) return null;

				var EP:int = getTrueEP( value ); // getEP( value );
				var letter:String = getDriveLetter( EP );
				var tons:int = getDriveTons( coreData[ 'tons by EP' ], EP, coreData[ 'min' ] );
				var mcr:Number = tons * coreData[ 'mcr' ];
				var CP:int = Math.ceil( tons / 35 );
				var note:String = getDriveNote( value, coreData.prefix, coreData.suffix );
				
				var basetl:int = findBaseTL( coreData[ 'tl' ], coreData[ 'ratingFromTL' ], value );
				var tl:int = basetl;
				
				//
				//  Now adjust upwards based on ship's TL.
				//
				var hdr:Object = Cfg.getHdr();
				if ( tl < hdr.tl )
					tl = hdr.tl;
				
				// reuse old drive, if there is one
				var replacement:Object = old;
				var newdrive:Boolean = (old == null);
				
				// otherwise, create new object
				if ( newdrive )
					replacement = {};
				
				replacement.type 		=  	'Drives';
				replacement.category 	= 	category;
				replacement.basetl 		=	basetl;
				replacement.tl 			=	tl;
				replacement.label 		=  	category + ' ' + letter;
				replacement.name 		=   category;
				replacement.tons 		=	tons;
				replacement.mcr 		=	mcr;
				replacement.rating 		= 	value;
				replacement.notes 		=	note;
				replacement.CP 			= 	CP;
				
				if ( newdrive )
					shipGrid.addComponent( replacement );
				
				shipGrid.refreshShipGrid();
				
				return replacement; // for tinkering with
			}
			
