			private function manuallySetCrewSpace():void
			{
				Cfg.getHdr().crewLocked = 'yes';
				setCrewSpace();
			}
			
			private function setCrewSpace():void
			{
				shipGrid.remove( 'Crew Space' );
				
				var extraTons:int   = crewAdditionalTons.value;
				var staterooms:int  = crewCount.value;
				var numShifts:int	= shifts.value;
				var troo:int    	= troopSquads.value;
				var staf:int    	= staff.value;
				
				var totalCrew:int = staterooms * numShifts + troo * 5;
				
				var hdr:Object = Cfg.getHdr();
				hdr.crewComfort = 0;
				hdr.crew = staterooms;
				hdr.shifts = numShifts;
				hdr.staff = staf;
				hdr.troops = troo;
				hdr.totalCrew = totalCrew;

				if ( totalCrew > 0 )
				{
					var totalTons:int = extraTons + staterooms * 4;
					// tons = (quality + 5) * totalCrew; 
					// tons/totalCrew = quality + 5
					// (tons/totalCrew) - 5 = quality
					var quality:int = (totalTons/totalCrew) - 5;
					hdr.crewComfort = quality;
					crewLivingQuality.value = quality;
					
					var mcr:Number = totalTons/8;

					var replacement:Object =
					{
						type: 		'Crew',
						category: 	'Crew Space',
						label: 		'Crew space (' + totalCrew + ', C=' + quality + ')',
						name:		'crew space',
						notes: 		totalCrew + ', Comfort=' + quality,
						tons: 		totalTons,
						mcr: 		mcr
					};
					
					shipGrid.addComponent( replacement );
				}
				
				updateLifeSupport();
			}
			

