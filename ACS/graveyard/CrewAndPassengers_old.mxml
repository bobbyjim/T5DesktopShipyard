			private function updateLifeSupport():void
			{
				shipGrid.remove( 'Life Support' );
				
				var hdr:Object = Cfg.getHdr();
				
				var people:int = hdr.totalCrew + hdr.medium + 2*hdr.high;
				
				if ( people == 0 ) return;
				
				var tons:int   = 0;
				var note:String = '';
				var dur:int;
				var mcr:Number;
				
				tons = Math.ceil(people / 10);
				dur  = tons * 300 / people;
				note = dur + ' days at capacity';
				mcr  = tons;
				
				if ( Cfg.getHdr().longTerm )
				{
					tons *= 3; // i.e. another 2 tons per 10 personnel
					dur = tons * 400 / people;
					note = dur + ' days at capacity';
					mcr  = tons;
				}

				var replacement:Object =
					{
						type: 'Ops',
						category: 'Life Support',
						label: 'Life support (' + dur + ' days)',
						name: 'life support', 
						notes: note,
						tons: tons,
						mcr: mcr,
						CP: Math.ceil(tons/10)
					};
				
				shipGrid.addComponent( replacement );
				
				shipGrid.remove( 'Luxury Life Support' );
				
				var hi:int = Cfg.getHdr().high;
				
				if ( hi > 0 )
				{
					tons = Math.ceil(hi / 10);
					mcr  = tons;
					
					var luxury:Object =
						{
							type: 'Ops',
							category: 'Luxury Life Support',
							label: 'Luxury life support',
							name: 'luxury life support',
							notes: hi + ' High passengers',
							tons: tons,
							mcr: mcr
						};
					
					shipGrid.addComponent( luxury );
				}
			}

