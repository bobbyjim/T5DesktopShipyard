		<![CDATA[
			import data.Cfg;
			
			import mx.collections.ArrayCollection;
			import mx.events.DragEvent;
			import mx.managers.DragManager;
			
			public var shipGrid:ShipGrid;

			private function init():void
			{
				updateUI();
			}
			
			private function reset():void
			{
				delete Cfg.getHdr().crewLocked;
				shipGrid.calculateCrewLevels();
				updateUI();
			}
			
			public function updateUI():void
			{
				var hdr:Object = Cfg.getHdr();
				
				bridge.value 			= hdr.spaciousness		|| 0;
				crewLivingQuality.value = hdr.crewComfort		|| 0;
				demand.value			= hdr.demand			|| 0;
				high.value  			= hdr.high				|| 0;
				medium.value 			= hdr.medium			|| 0;
				low.value				= hdr.low				|| 0;
			    shifts.value    		= hdr.shifts			|| 0;
				crewCount.value 		= hdr.crew				|| 0;
				
 				pilot.value 			= hdr.pilot				|| 0;
				astrogator.value		= hdr.astrogator		|| 0;
				sensop.value			= hdr.sensop			|| 0;
				steward.value			= hdr.steward			|| 0;
				medic.value				= hdr.medic				|| 0;
				gunner.value			= hdr.gunner			|| 0;
				driver.value			= hdr.driver			|| 0;
				engineer.value			= hdr.engineer			|| 0;
				freightmaster.value		= hdr.freightmaster		|| 0;
				staff.value				= hdr.staff 			|| 0;
				troopSquads.value		= hdr.troops 			|| 0;
 	
				longTerm.selected = Cfg.getHdr().longTerm;

				setBridge();
				setPassengerSpace();
				setLowPassageSpace();
				setCrewSpace();
				updateLifeSupport();
			}

			public function resetUI():void
			{
				bridge.value = 2;
				crewLivingQuality.value 
					= demand.value
					= high.value
					= medium.value
					= low.value
					= 0;
				shifts.value = 1;
				crewCount.value = 0;
				
				pilot.value
					= this.astrogator.value
					= sensop.value
					= steward.value
					= medic.value
					= gunner.value
					= driver.value
					= engineer.value
					= freightmaster.value
					= staff.value
					= troopSquads.value
					= 0;
				
				longTerm.selected = false;
			}
			
			private function setValue( stepper:NumericStepper, name:String ):void
			{
				var obj:Object = Cfg.getInstance().find( name );
				if ( obj != null && obj.hasOwnProperty( 'amount' ) )
					stepper.value = obj[ 'amount' ];
			}
			
			private function setSkill(event:Event):void
			{
				setBridge();
				manuallySetCrewSpace();
				updateLifeSupport();
			}
			
			private function setLongTerm( event:Event ):void
			{
				Cfg.getHdr().longTerm = event.target.selected;
				updateLifeSupport();
			}

			private function setBridge():void
			{
				shipGrid.remove( 'Bridge' );

				var pilo:int = pilot.value 		;
				var astr:int = astrogator.value	;
				var sens:int = sensop.value		;
				var stew:int = steward.value		;
				var medi:int = medic.value		    ;
				var gunn:int = gunner.value		;
				var driv:int = driver.value		;
				var engi:int = engineer.value	;
				var frei:int = freightmaster.value	;
				
				var skillTotal:int = pilo + astr + sens + stew + medi + gunn + driv + engi + frei;
								
				var spaciousness:Number = bridge.value;

				var hdr:Object = Cfg.getHdr();

				hdr.pilot = pilo;
				hdr.astrogator = astr;
				hdr.sensop = sens;
				hdr.steward = stew;
				hdr.medic = medi;
				hdr.gunner = gunn;
				hdr.driver = driv;
				hdr.engineer = engi;
				hdr.freightmaster = frei;
				hdr.spaciousness = spaciousness;

				if ( skillTotal == 0 ) return;

				var tons:Number = Math.ceil( skillTotal * spaciousness * 2 ) / 2; // to the half ton
				var label:String = 'Standard Bridge';
				var notes:String = ''; // Standard';
				var mod:int = 0;
				
				if ( spaciousness == 0.5 )
				{
					label = 'Cramped bridge';
					mod = -2;
					//notes = 'Cramped';
				}
				else if ( spaciousness == 2.0 ) 
				{
					label = 'Spacious bridge';
					mod = 2;
					//notes = 'Spacious';
				}
				
				var bridge:Object =
					{
						type: 'Ops',
						category: 'Bridge',
						name: 'Bridge',
						label: label,
						notes: notes,
						tons: tons,
						mod: mod,
						mcr: 0
					};
				
				shipGrid.addComponent( bridge );
			}
			
			private function setLowPassageSpace():void
			{
				shipGrid.remove( 'Low Berths' );
				var hdr:Object = Cfg.getHdr();
				var lo:int  = low.value;
				hdr.low = lo;
				
				var tons:Number;
				var mcr:Number;

				if ( lo == 0 ) return;
				
				tons = lo/2;
				mcr = lo * 0.1; // to KCr 100
					
				var berths:Object =
						{
							type: 'Passengers',
							category: 'Low Berths',
							label: 'Low berths (' + lo + ')',
							name: 'low berths',
							notes: lo,
							tons: tons,
							mcr: mcr
						};
					
				shipGrid.addComponent( berths );	
			}
			
			private function setPassengerSpace():void
			{
				shipGrid.remove( 'Passenger Space' );
				
				var hdr:Object = Cfg.getHdr();
				var hi:int = high.value;
				var me:int  = medium.value;
				var pax:int  = hi + me;
				var extraSpace:int = passengerAdditionalTons.value;
				
				hdr.passengers = pax;
				hdr.high = hi;
				hdr.medium = me;
//				hdr.demand = demand.value;
				
				if ( pax == 0 ) return;
				
				var tons:Number = pax * 4 + extraSpace;
				var mcr:Number  = tons/8;
				
				// D = (T/P)-5
				// (D+5) x P = T
				//tons = (demand.value + 5) * pax;
				hdr.demand = (tons/pax) - 5;
				demand.value = hdr.demand;
				
				//if ( tons < pax/2 ) tons = pax/2;
								
				var replacement:Object =
				{
					type: 'Passengers',
					category: 'Passenger Space',
					label: 'Passenger space (' + hi + '/' + me + ', D=' + demand.value + ')',
					name: 'passenger space',
					notes: hi + '/' + me + ', Demand=' + demand.value,
					tons: tons,
					mcr: mcr
				};
				
				shipGrid.addComponent( replacement );
				setCrewSpace();
			}
			
