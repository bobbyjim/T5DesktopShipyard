	<s:Button x="186" y="9" width="50" label="HTML" click="IO.toHTML()" enabled="true"
			  fontFamily="Arial" fontSize="11" toolTip="Create an HTML document of the design sheet"/>
	<s:Button x="377" y="43" width="45" label="D64" click="IO.toD64()" enabled="true"
			  fontFamily="Arial" fontSize="9" toolTip="Create a Commodore 1541 diskette image from the design sheet"/>
	<s:Label x="80" y="14.5" text="Save as:"/>

</s:Group>
